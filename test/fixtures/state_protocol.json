        {"notes": "values_changed", "delta": {"delta_index": 6, "delta": [{"path": ["score", "1", "team", "1", "score"], "action": "values_changed", "value": 1}]}, "status": "applied", "resync": false, "index": 6, "state": {"score": {"1": {"best_of": 3, "team": {"1": {"score": 1, "player": {"1": {"name": "Alice"}}}, "2": {"score": 0, "player": {"1": {"name": "Bob"}}}}}}, "bracket": {"focus": {"main": {"sets": ["m1", "m2", "m3"], "rounds": [{"name": "w:1", "sets": 2}, {"name": "w:2", "sets": 1}]}}}, "game": {"name": "Game", "codename": "game"}, "commentary": {"1": {"name": "Carol"}, "2": {"name": "Dan"}}}},
