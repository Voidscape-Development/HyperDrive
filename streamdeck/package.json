{
	"name": "hyperdrive-streamdeck",
	"version": "1.0.0",
	"private": true,
	"description": "Stream Deck plugin for HyperDrive",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.voidscape.hyperdrive\"",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"validate": "streamdeck validate com.voidscape.hyperdrive.sdPlugin",
		"pack": "npm run build && streamdeck pack com.voidscape.hyperdrive.sdPlugin --output dist --force",
		"check": "npm run typecheck && npm test && npm run build && npm run validate",
		"images": "node scripts/generate-images.ts"
	},
	"dependencies": {
		"@elgato/streamdeck": "2.1.2",
		"@elgato/utils": "0.6.1",
		"socket.io-client": "4.8.3"
	},
	"devDependencies": {
		"@elgato/cli": "1.10.2",
		"@rollup/plugin-commonjs": "29.0.3",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-terser": "1.0.0",
		"@rollup/plugin-typescript": "12.3.0",
		"@types/node": "24.13.6",
		"rollup": "4.63.5",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
